        <string name="Name">GIF</string>
        <string name="Source">local Composer = require(script.Composer)
local Decoder = require(script.Decoder)

local GIF = {}

GIF.new = Composer.new
GIF.Decode = Decoder.Decode --for debugging kek

return GIF</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Composer</string>
          <string name="Source">local Decoder = require(script.Parent.Decoder)

local Composer = {}
Composer.__index = Composer

local Frame = {}
Frame.__index = Frame

function Frame:GetPixel(x, y)
	x = math.clamp(math.floor(x), 0, self.Width - 1)
	y = math.clamp(math.floor(y), 0, self.Height - 1)

	local offset = (y * self.Width + x) * 4
	local canvas = self.Canvas

	local r = buffer.readu8(canvas, offset)
	local g = buffer.readu8(canvas, offset + 1)
	local b = buffer.readu8(canvas, offset + 2)
	local a = buffer.readu8(canvas, offset + 3)

	return Color3.fromRGB(r, g, b), a
end

function Frame:Clone()
	local size = buffer.len(self.Canvas)
	local copy = buffer.create(size)
	buffer.copy(copy, 0, self.Canvas, 0, size)

	return setmetatable({
		Width = self.Width,
		Height = self.Height,
		Canvas = copy,
		Index = self.Index,
		Delay = self.Delay,
	}, Frame)
end

local function newCanvas(width, height)

	return buffer.create(math.max(width * height * 4, 1))
end

local function colorAt(colorTable, index)
	local entry = colorTable and colorTable[index]
	if entry then
		return entry[1], entry[2], entry[3]
	end
	return 0, 0, 0
end

local function clearRect(canvas, canvasWidth, canvasHeight, left, top, width, height)
	for y = math.max(top, 0), math.min(top + height, canvasHeight) - 1 do
		local rowOffset = y * canvasWidth
		for x = math.max(left, 0), math.min(left + width, canvasWidth) - 1 do
			local offset = (rowOffset + x) * 4
			buffer.writeu8(canvas, offset, 0)
			buffer.writeu8(canvas, offset + 1, 0)
			buffer.writeu8(canvas, offset + 2, 0)
			buffer.writeu8(canvas, offset + 3, 0)
		end
	end
end

local function drawFrame(canvas, canvasWidth, canvasHeight, frame)
	local indices = frame.Indices
	local colorTable = frame.ColorTable
	local transparentIndex = frame.TransparentIndex
	local fw, fh = frame.Width, frame.Height

	for y = 0, fh - 1 do
		local cy = frame.Top + y
		if cy >= 0 and cy &lt; canvasHeight then
			local srcRow = y * fw
			local rowOffset = cy * canvasWidth

			for x = 0, fw - 1 do
				local cx = frame.Left + x
				if cx >= 0 and cx &lt; canvasWidth then
					local index = buffer.readu8(indices, srcRow + x)

					if index ~= transparentIndex then
						local r, g, b = colorAt(colorTable, index)
						local offset = (rowOffset + cx) * 4
						buffer.writeu8(canvas, offset, r)
						buffer.writeu8(canvas, offset + 1, g)
						buffer.writeu8(canvas, offset + 2, b)
						buffer.writeu8(canvas, offset + 3, 255)
					end
				end
			end
		end
	end
end

local function applyDisposal(canvas, canvasWidth, canvasHeight, frame)
	if frame.Disposal == 2 then
		clearRect(canvas, canvasWidth, canvasHeight, frame.Left, frame.Top, frame.Width, frame.Height)
	elseif frame.Disposal == 3 and frame._snapshot then
		buffer.copy(canvas, 0, frame._snapshot, 0, buffer.len(canvas))
	end

end

function Composer.new(data)
	local raw = Decoder.Decode(data)

	local self = setmetatable({}, Composer)

	self.Width = raw.Width
	self.Height = raw.Height
	self.LoopCount = raw.LoopCount
	self.BackgroundColorIndex = raw.BackgroundColorIndex
	self.GlobalColorTable = raw.GlobalColorTable
	self._frames = raw.Frames

	self._canvas = newCanvas(self.Width, self.Height)
	self._cursor = 0

	return self
end

function Composer:GetFrameCount()
	return #self._frames
end

function Composer:GetFrameDelay(descriptorIndex)
	local frame = self._frames[descriptorIndex]
	return frame and frame.Delay or 0
end

function Composer:GetDuration()
	local total = 0
	for _, frame in ipairs(self._frames) do
		total += frame.Delay
	end
	return total
end

function Composer:GetFPS()
	local count = #self._frames
	local duration = self:GetDuration()
	if duration &lt;= 0 then
		return 0
	end
	return count / duration
end

function Composer:_advance()
	local count = #self._frames
	local absolute = self._cursor + 1
	local descriptorIndex = ((absolute - 1) % count) + 1
	local frame = self._frames[descriptorIndex]

	if self._cursor > 0 then
		local prevDescriptorIndex = ((self._cursor - 1) % count) + 1
		applyDisposal(self._canvas, self.Width, self.Height, self._frames[prevDescriptorIndex])
	end

	if frame.Disposal == 3 then

		if not frame._snapshot then
			frame._snapshot = newCanvas(self.Width, self.Height)
		end
		buffer.copy(frame._snapshot, 0, self._canvas, 0, buffer.len(self._canvas))
	end

	drawFrame(self._canvas, self.Width, self.Height, frame)
	self._cursor = absolute
end

function Composer:GetFrame(absoluteIndex)
	absoluteIndex = math.max(1, math.floor(absoluteIndex))
	local count = #self._frames

	if absoluteIndex &lt; self._cursor then
		self._canvas = newCanvas(self.Width, self.Height)
		self._cursor = 0
	end

	while self._cursor &lt; absoluteIndex do
		self:_advance()
	end

	local descriptorIndex = ((absoluteIndex - 1) % count) + 1
	local frame = self._frames[descriptorIndex]

	return setmetatable({
		Width = self.Width,
		Height = self.Height,
		Canvas = self._canvas,
		Index = descriptorIndex,
		AbsoluteIndex = absoluteIndex,
		Delay = frame.Delay,
	}, Frame)
end

return Composer</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Decoder</string>
          <string name="Source">local BinaryReader = require(script.Parent.Parent.PNG.BinaryReader)
local LZW = require(script.Parent.LZW)

local Decoder = {}

local band = bit32.band
local rshift = bit32.rshift

local EXTENSION_INTRODUCER = 0x21
local IMAGE_SEPARATOR = 0x2C
local TRAILER = 0x3B

local GRAPHIC_CONTROL_LABEL = 0xF9
local APPLICATION_LABEL = 0xFF
local COMMENT_LABEL = 0xFE
local PLAINTEXT_LABEL = 0x01

local function readUInt16LE(reader)
	local low = reader:ReadByte()
	local high = reader:ReadByte()

	if not low or not high then
		return 0
	end

	return low + high * 256
end

local function readColorTable(reader, sizeField)
	local count = bit32.lshift(1, sizeField + 1)
	local colors = {}

	for i = 0, count - 1 do
		local r, g, b = reader:ReadBytes(3)
		colors[i] = { r or 0, g or 0, b or 0 }
	end

	return colors
end

local function readSubBlocks(reader)
	local parts = {}
	local count = 0

	while true do
		local size = reader:ReadByte()
		if not size or size == 0 then
			break
		end
		count += 1
		parts[count] = reader:ReadString(size)
	end

	return table.concat(parts)
end

local function skipSubBlocks(reader)
	while true do
		local size = reader:ReadByte()
		if not size or size == 0 then
			break
		end
		reader:ReadString(size)
	end
end

local INTERLACE_PASSES = {
	{ start = 0, step = 8 },
	{ start = 4, step = 8 },
	{ start = 2, step = 4 },
	{ start = 1, step = 2 },
}

local function deinterlace(source, width, height)
	local dest = buffer.create(width * height)
	local srcRow = 0

	for _, pass in ipairs(INTERLACE_PASSES) do
		local y = pass.start
		while y &lt; height do
			buffer.copy(dest, y * width, source, srcRow * width, width)
			srcRow += 1
			y += pass.step
		end
	end

	return dest
end

function Decoder.Decode(data)
	local reader = BinaryReader.new(data)

	local magic = reader:ReadString(6)
	if magic ~= "GIF87a" and magic ~= "GIF89a" then
		error("GIF - Input data is not a GIF file.", 2)
	end

	local gif = {
		Version = magic,
		Frames = {},
		LoopCount = nil,
	}

	gif.Width = readUInt16LE(reader)
	gif.Height = readUInt16LE(reader)

	local lsdPacked = reader:ReadByte() or 0
	local hasGCT = band(lsdPacked, 0x80) ~= 0
	local gctSize = band(lsdPacked, 0x07)

	gif.BackgroundColorIndex = reader:ReadByte() or 0
	gif.PixelAspectRatio = reader:ReadByte() or 0

	if hasGCT then
		gif.GlobalColorTable = readColorTable(reader, gctSize)
	end

	local pendingDelay = 0
	local pendingDisposal = 0
	local pendingTransparentIndex = nil
	local pendingUserInput = false

	while true do
		local blockType = reader:ReadByte()

		if not blockType or blockType == TRAILER then
			break
		elseif blockType == EXTENSION_INTRODUCER then
			local label = reader:ReadByte()

			if label == GRAPHIC_CONTROL_LABEL then
				reader:ReadByte()
				local gcePacked = reader:ReadByte() or 0

				pendingDisposal = band(rshift(gcePacked, 2), 0x07)
				pendingUserInput = band(gcePacked, 0x02) ~= 0
				local hasTransparency = band(gcePacked, 0x01) ~= 0

				pendingDelay = readUInt16LE(reader) / 100

				local transparentIndex = reader:ReadByte() or 0
				pendingTransparentIndex = hasTransparency and transparentIndex or nil

				reader:ReadByte()
			elseif label == APPLICATION_LABEL then
				reader:ReadByte()
				local appId = reader:ReadString(11)
				local appData = readSubBlocks(reader)

				if appId == "NETSCAPE2.0" and #appData >= 3 then
					local lo = appData:byte(2)
					local hi = appData:byte(3)
					gif.LoopCount = lo + hi * 256
				end
			elseif label == COMMENT_LABEL then
				skipSubBlocks(reader)
			elseif label == PLAINTEXT_LABEL then
				reader:ReadByte()
				reader:ReadString(12)
				skipSubBlocks(reader)
			else

				skipSubBlocks(reader)
			end
		elseif blockType == IMAGE_SEPARATOR then
			local left = readUInt16LE(reader)
			local top = readUInt16LE(reader)
			local width = readUInt16LE(reader)
			local height = readUInt16LE(reader)

			local idPacked = reader:ReadByte() or 0
			local hasLCT = band(idPacked, 0x80) ~= 0
			local isInterlaced = band(idPacked, 0x40) ~= 0
			local lctSize = band(idPacked, 0x07)

			local localColorTable = nil
			if hasLCT then
				localColorTable = readColorTable(reader, lctSize)
			end

			local minCodeSize = reader:ReadByte() or 2
			local compressed = readSubBlocks(reader)

			local pixelCount = width * height
			local indices = buffer.create(math.max(pixelCount, 1))

			if pixelCount > 0 then
				local subReader = BinaryReader.new(compressed)
				LZW.Decode(subReader, minCodeSize, indices, pixelCount)

				if isInterlaced then
					indices = deinterlace(indices, width, height)
				end
			end

			table.insert(gif.Frames, {
				Left = left,
				Top = top,
				Width = width,
				Height = height,
				Indices = indices,
				ColorTable = localColorTable or gif.GlobalColorTable,

				Delay = pendingDelay > 0 and pendingDelay or 0.1,
				Disposal = pendingDisposal,
				TransparentIndex = pendingTransparentIndex,
				UserInput = pendingUserInput,
			})

			pendingDelay = 0
			pendingDisposal = 0
			pendingTransparentIndex = nil
			pendingUserInput = false
		else

			break
		end
	end
	return gif
end

return Decoder</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">LZW</string>
          <string name="Source">--[[

	GIF/LZW.luau

	Decompresses GIF's variable-width LZW-compressed image data.

	This is NOT the same algorithm as PNG/Deflate.luau (DEFLATE is
	Huffman-coded LZ77; GIF uses a variant of LZW), but it reuses the same
	*bit-packing convention* PNG/Deflate.luau's bitstream already relies on:
	codes are packed into bytes starting from the least-significant bit,
	continuing across byte boundaries. That means the same
	"accumulate into a buffer, peel bits off the bottom" reader shape works
	here too, just sized for GIF's 2-12 bit variable code width.

	Reference: GIF89a Specification, Appendix F (LZW Compression / Variable-
	Length-Code / Clear Code handling).
	i vibecoded ts because i was tired kek (thx to qwen 3.8 27B)
]]

local LZW = {}

local lshift = bit32.lshift
local rshift = bit32.rshift
local band = bit32.band

-- LSB-first bit reader over a BinaryReader (see PNG/BinaryReader.luau).
local function createBitStream(reader)
	local buf = 0
	local bitsLeft = 0

	local stream = {}

	function stream:Read(count)
		while bitsLeft &lt; count do
			local byte = reader:ReadByte()

			if not byte then
				-- Ran out of input. Only an error if the caller still
				-- needed more bits than we have buffered.
				if bitsLeft == 0 then
					return nil
				end
				break
			end

			buf = buf + lshift(byte, bitsLeft)
			bitsLeft = bitsLeft + 8
		end

		if bitsLeft &lt; count then
			return nil
		end

		local bits = band(buf, lshift(1, count) - 1)
		buf = rshift(buf, count)
		bitsLeft = bitsLeft - count

		return bits
	end

	return stream
end

local MAX_CODE_SIZE = 12
local MAX_DICT_SIZE = lshift(1, MAX_CODE_SIZE)

--[[
	Decode(reader, minCodeSize, output, expected)

	reader        - BinaryReader positioned at the start of the GIF image
	                data's already-concatenated sub-blocks (i.e. the block
	                size bytes have already been stripped out; see
	                Decoder.luau's readSubBlocks).
	minCodeSize   - the "LZW Minimum Code Size" byte from the image data
	                block (2-8).
	output        - a pre-sized `buffer` to write decoded palette indices
	                into, one byte per pixel.
	expected      - number of index bytes expected (Width * Height of the
	                frame). Decoding stops once this many bytes have been
	                written, or the stream runs out / hits its End code,
	                whichever comes first.

	Returns the number of bytes actually written. Malformed/truncated
	streams are tolerated (decoding just stops early) rather than raising,
	since corrupt-but-mostly-fine GIFs exist in the wild and a partially
	decoded frame is more useful than a hard failure.
]]
function LZW.Decode(reader, minCodeSize, output, expected)
	if expected &lt;= 0 then
		return 0
	end

	local clearCode = lshift(1, minCodeSize)
	local endCode = clearCode + 1

	local dict = {}
	local codeSize, nextCode, prevCode

	local function resetDict()
		table.clear(dict)
		for i = 0, clearCode - 1 do
			dict[i] = string.char(i)
		end
		nextCode = endCode + 1
		codeSize = minCodeSize + 1
		prevCode = nil
	end

	resetDict()

	local bitStream = createBitStream(reader)
	local written = 0

	local function emit(str)
		local len = #str
		if written + len > expected then
			len = expected - written
			if len &lt;= 0 then
				return
			end
			str = str:sub(1, len)
		end

		buffer.writestring(output, written, str)
		written += len
	end

	while written &lt; expected do
		local code = bitStream:Read(codeSize)

		if code == nil or code == endCode then
			break
		end

		if code == clearCode then
			resetDict()

			code = bitStream:Read(codeSize)
			if code == nil or code == endCode then
				break
			end

			local entry = dict[code]
			if not entry then
				break -- corrupt stream: first code after Clear must be a literal
			end

			emit(entry)
			prevCode = code
		else
			local entry

			if dict[code] then
				entry = dict[code]
			elseif code == nextCode and prevCode ~= nil then
				-- The classic LZW "KwKwK" special case: the code being
				-- read is the one about to be *defined*.
				local prevEntry = dict[prevCode]
				entry = prevEntry .. prevEntry:sub(1, 1)
			else
				break -- corrupt/unexpected code
			end

			emit(entry)

			if nextCode &lt; MAX_DICT_SIZE and prevCode ~= nil then
				dict[nextCode] = dict[prevCode] .. entry:sub(1, 1)
				nextCode += 1

				if nextCode >= lshift(1, codeSize) and codeSize &lt; MAX_CODE_SIZE then
					codeSize += 1
				end
			end
			-- If the dictionary is full (4096 entries) and the encoder
			-- doesn't send an explicit Clear, we just stop growing it and
			-- keep decoding at 12 bits/code, per common decoder practice.

			prevCode = code
		end
	end

	return written
end

return LZW</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Player</string>
          <string name="Source">local RunService = game:GetService("RunService")

local Composer = require(script.Parent.Composer)
local Signal = require(script.Parent.Signal)

local GIFPlayer = {}
GIFPlayer.__index = GIFPlayer

local wawa = 1 / 60

function GIFPlayer.new(gifData)
	local self = setmetatable({}, GIFPlayer)

	self._gif = Composer.new(gifData)

	self._speed = 1

	self._looping = self._gif.LoopCount ~= nil

	self._absoluteFrame = 1
	self._frameIndex = 1
	self._accumulated = 0
	self._playing = false
	self._destroyed = false
	self._connection = nil

	self.FrameChanged = Signal.new()
	self.Completed = Signal.new()
	self.PlayingChanged = Signal.new()

	return self
end

function GIFPlayer:GetFrameCount()
	return self._gif:GetFrameCount()
end

function GIFPlayer:GetFPS()
	return self._gif:GetFPS()
end

function GIFPlayer:GetDuration()
	return self._gif:GetDuration()
end

function GIFPlayer:GetDimensions()
	return self._gif.Width, self._gif.Height
end

function GIFPlayer:GetCurrentFrameIndex()
	return self._frameIndex
end

function GIFPlayer:IsPlaying()
	return self._playing
end

function GIFPlayer:SetSpeed(speed)
	assert(type(speed) == "number" and speed > 0, "GIFPlayer:SetSpeed expects a positive number")
	self._speed = speed
end

function GIFPlayer:SetLooping(looping)
	self._looping = looping and true or false
end

function GIFPlayer:_setPlaying(playing)
	if self._playing ~= playing then
		self._playing = playing
		self.PlayingChanged:Fire(playing)
	end
end

function GIFPlayer:_showFrame(absoluteIndex)
	local frame = self._gif:GetFrame(absoluteIndex)
	self._absoluteFrame = absoluteIndex
	self._frameIndex = frame.Index
	self.FrameChanged:Fire(frame.Index, frame)
	return frame
end

function GIFPlayer:_step(dt)
	if self._destroyed or not self._playing then
		return
	end

	local count = self._gif:GetFrameCount()
	self._accumulated += dt * self._speed

	local delay = math.max(self._gif:GetFrameDelay(self._frameIndex), wawa)

	while self._accumulated >= delay do
		self._accumulated -= delay

		if self._frameIndex >= count and not self._looping then
			self:_setPlaying(false)
			self.Completed:Fire()
			return
		end

		self:_showFrame(self._absoluteFrame + 1)
		delay = math.max(self._gif:GetFrameDelay(self._frameIndex), wawa)
	end
end

function GIFPlayer:Play()
	if self._destroyed or self._playing then
		return
	end

	self._accumulated = 0

	if not self._connection then
		self._connection = RunService.Heartbeat:Connect(function(dt)
			self:_step(dt)
		end)
	end

	self:_setPlaying(true)
	self:_showFrame(self._absoluteFrame)
end

function GIFPlayer:Pause()
	self:_setPlaying(false)
end

function GIFPlayer:Resume()
	if self._destroyed then
		return
	end
	self:_setPlaying(true)
end

function GIFPlayer:Stop()
	self:_setPlaying(false)
	self._absoluteFrame = 1
	self._frameIndex = 1
	self._accumulated = 0
end

function GIFPlayer:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self:_setPlaying(false)

	if self._connection then
		self._connection:Disconnect()
		self._connection = nil
	end

	self.FrameChanged:DisconnectAll()
	self.Completed:DisconnectAll()
	self.PlayingChanged:DisconnectAll()
end

return GIFPlayer</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source">local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _connections = {}, _nextId = 1 }, Signal)
end

function Signal:Connect(fn)
	local id = self._nextId
	self._nextId += 1
	self._connections[id] = fn

	local connections = self._connections
	local connection = { Connected = true }

	function connection:Disconnect()
		if self.Connected then
			connections[id] = nil
			self.Connected = false
		end
	end
	connection.Destroy = connection.Disconnect

	return connection
end

function Signal:Fire(...)
	for _, fn in pairs(self._connections) do
		local ok, err = pcall(fn, ...)
		if not ok then
		end
	end
end

function Signal:DisconnectAll()
	table.clear(self._connections)
end

return Signal</string>
        </Properties>
      </Item>
    </Item>
